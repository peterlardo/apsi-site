{
  "name": "apsi-cg-server",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "main": "index.js",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:apply": "wrangler d1 execute apsi-cg --remote --file=../migrations/0001_initial.sql",
    "db:seed": "wrangler d1 execute apsi-cg --remote --file=../migrations/0002_seed.sql",
    "db:migrate": "wrangler d1 execute apsi-cg --remote --file=../migrations/0003_mysql_data.sql"
  },
  "dependencies": {
    "hono": "^4.7.0",
    "jose": "^6.0.0",
    "bcryptjs": "^3.0.2"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.0.0",
    "wrangler": "^3.0.0"
  }
}
